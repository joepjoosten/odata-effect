{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "codegen": "pnpm --recursive --parallel run codegen",
    "build": "tsc -b tsconfig.build.json && pnpm --recursive --parallel run build",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "check": "effect-tsgo tsrs -b tsconfig.json",
    "check-tsc": "tsc -b tsconfig.json",
    "check-recursive": "pnpm --recursive exec tsc -b tsconfig.json",
    "lint": "oxlint -f unix && dprint check",
    "lint-fix": "oxlint --fix && dprint fmt",
    "changeset-version": "changeset version && pnpm install --lockfile-only",
    "changeset-publish": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.13",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.1",
    "@effect/build-utils": "^0.7.9",
    "@effect/tsgo": "^0.67.5",
    "@effect/vitest": "4.1.3",
    "@types/node": "^22.20.5",
    "babel-plugin-annotate-pure-calls": "^0.5.0",
    "dprint": "^0.64.3",
    "effect": "4.1.3",
    "esbuild": "0.27.2",
    "glob": "^11.1.0",
    "oxlint": "^1.93.0",
    "rollup": "4.68.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
